# ─── BASE DE DONNÉES ───────────────────────────────────────────
# PostgreSQL (production : Neon, Supabase, Vercel Postgres)
# Format : postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/eleo_formation?sslmode=require"

# ─── AUTHENTIFICATION ──────────────────────────────────────────
# Générez un secret aléatoire long : openssl rand -base64 32
JWT_SECRET="change-this-to-a-random-secret-in-production"

# ─── IA (OpenRouter recommandé, gratuit) ──────────────────────
AI_PROVIDER="openrouter"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-oss-120b:free"
OPENROUTER_FALLBACK_MODELS="qwen/qwen3-next-80b-a3b-instruct:free,z-ai/glm-4.5-air:free,meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free"
OPENROUTER_SITE_URL="https://formation.eleo-informatique.fr"
OPENROUTER_APP_NAME="Eleo Formation"

# ─── APPLICATION ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://formation.eleo-informatique.fr"

# ─── EMAILS TRANSACTIONNELS (Resend) ───────────────────────────
# Créer un compte gratuit sur https://resend.com (3000 emails/mois gratuits)
# 1. Settings > API Keys > Create API Key > "Sending access" > Copier la clé
RESEND_API_KEY=""
# Expéditeur : par défaut, Resend autorise "onboarding@resend.dev" sans config DNS
# Pour utiliser votre domaine : Domains > Add Domain > configurer SPF/DKIM chez o2switch
EMAIL_FROM="Eleo Formation <onboarding@resend.dev>"
# Email de reply-to et destinataire des notifications admin
EMAIL_REPLY_TO="eleo.informatique@gmail.com"
NOTIFICATION_EMAIL="eleo.informatique@gmail.com"

# ─── WORDPRESS REST API (intégration eleo-informatique.fr) ─────
# Mot de passe d'application WordPress (générer dans Utilisateurs > Profil > Mots de passe d'application)
WP_SITE_URL="https://eleo-informatique.fr"
WP_USER=""
WP_APP_PASSWORD=""
